#!/bin/bash

set -eux

## MAKE SURE TO UPDATE IN EACH RELEASE ##
RHWA_RELEASE=24.3 # Update URL link to OCP docs
PREVIOUS_VERSION="0.8.0" # For the replaces field in the CSV, set to the last released version, Prevents removal of that version from index
# For an eus release SKIP_RANGE_LOWER should be set to the EUS release immediately preceding the latest one (i.e for example at 0.9.0 eus-4.16 set SKIP_RANGE_LOWER to 0.7.X which matches eus-4.14), this is done in order to allow update from prev eus to latest eus release.
# For a non eus release SKIP_RANGE_LOWER should be set to latest eus release (in order to enable upgrade from the eus to the latest stable)
SKIP_RANGE_LOWER="0.7.0"
# Bundle channels !!! keep aligned with the channels in the Dockerfile.in !!!!
#CHANNELS=stable
CHANNELS=4.16-eus,stable

RBAC_PROXY_OCP_VERSION="4.15"

# Fixes vars
UPSTREAM_DIR="upstream"
MANIFESTS_DIR="bundle/manifests"
METADATA_DIR="bundle/metadata"
TESTS_DIR="bundle/tests"
OPERATOR_NAME="self-node-remediation"
CSV=${MANIFESTS_DIR}/${OPERATOR_NAME}.clusterserviceversion.yaml
ANNOTATIONS=${METADATA_DIR}/annotations.yaml

# Get upstream repository
rm -rf "${UPSTREAM_DIR}"
git config --global core.sshCommand 'ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no'
git clone "${CI_SELF_NODE_REMEDIATION_UPSTREAM_URL}" "${UPSTREAM_DIR}"
[ $? -ne 0 ] && { echo "ERROR: Could not clone upstream release repo."; exit 4; }
cd "${UPSTREAM_DIR}"
git checkout "${CI_SELF_NODE_REMEDIATION_UPSTREAM_COMMIT}"
cd ..

# Copy upstream manifests
rm -rf "${MANIFESTS_DIR}" "${METADATA_DIR}" "${TESTS_DIR}"
mkdir -p bundle
mv "${UPSTREAM_DIR}/bundle/manifests" "${MANIFESTS_DIR}"
mv "${UPSTREAM_DIR}/bundle/metadata" "${METADATA_DIR}"
mv "${UPSTREAM_DIR}/bundle/tests" "${TESTS_DIR}"

# Update image URLs
# Note: "mage: ..." matches both image and containerImage
sed -r -i "s|mage: quay.io/medik8s/${OPERATOR_NAME}.*|mage: registry-proxy.engineering.redhat.com/rh-osbs/red-hat-workload-availability-${OPERATOR_NAME}:v${CI_VERSION}|g;" "${CSV}"
sed -r -i "s|value: quay.io/medik8s/${OPERATOR_NAME}.*|value: registry-proxy.engineering.redhat.com/rh-osbs/red-hat-workload-availability-${OPERATOR_NAME}:v${CI_VERSION}|g;" "${CSV}"
sed -r -i "s|mage: .*/kube-rbac-proxy.*|mage: registry.redhat.io/openshift4/ose-kube-rbac-proxy:v${RBAC_PROXY_OCP_VERSION}|g;" "${CSV}"

# Update build date
sed -r -i "s|createdAt: .*|createdAt: `date '+%Y-%m-%d %T'`|;" "${CSV}"

# Update version
sed -r -i "s|name: ${OPERATOR_NAME}.v.*|name: ${OPERATOR_NAME}.v${CI_VERSION}|;" "${CSV}"
sed -r -i "s|version: 0.0.1|version: ${CI_VERSION}|;" "${CSV}"
sed -r -i "s|olm.skipRange: .*|olm.skipRange: '>=${SKIP_RANGE_LOWER} <${CI_VERSION}'|;" ${CSV}

# add replaces field
sed -r -i "/  version: ${CI_VERSION}/ a\  replaces: ${OPERATOR_NAME}.v${PREVIOUS_VERSION}" ${CSV}


# Update Medik8s to Dragonfly
sed -r -i "s|email: medik8s@googlegroups.com|email: team-dragonfly@redhat.com|;" "${CSV}"
sed -r -i "s|name: Medik8s Team|name: Dragonfly Team|;" "${CSV}"

# Update Medik8s to Red Hat 
sed -r -i "s|support: Medik8s|support: Red Hat|;" "${CSV}"
sed -r -i "s|  name: Medik8s|  name: Red Hat|;" "${CSV}"
sed -r -i "s|url: https://www.medik8s.io/|url: https://www.redhat.com|;" "${CSV}"

# Add OCP Annotations
sed -r -i "/    olm.skipRange:.*/a \    operators.openshift.io/valid-subscription: '[\"OpenShift Kubernetes Engine\", \"OpenShift Container Platform\", \"OpenShift Platform Plus\"]'" "${CSV}"
sed -r -i "/    olm.skipRange:.*/a \    features.operators.openshift.io/disconnected: \"true\"" "${CSV}"
sed -r -i "/    olm.skipRange:.*/a \    features.operators.openshift.io/fips-compliant: \"true\"" "${CSV}"
sed -r -i "/    olm.skipRange:.*/a \    features.operators.openshift.io/proxy-aware: \"false\"" "${CSV}"
sed -r -i "/    olm.skipRange:.*/a \    features.operators.openshift.io/tls-profiles: \"false\"" "${CSV}"
sed -r -i "/    olm.skipRange:.*/a \    features.operators.openshift.io/token-auth-aws: \"false\"" "${CSV}"
sed -r -i "/    olm.skipRange:.*/a \    features.operators.openshift.io/token-auth-azure: \"false\"" "${CSV}"
sed -r -i "/    olm.skipRange:.*/a \    features.operators.openshift.io/token-auth-gcp: \"false\"" "${CSV}"

# Update URL link to OCP docs
sed -r -i "s|url: https://medik8s.io|url: https://access.redhat.com/documentation/en-us/workload_availability_for_red_hat_openshift/$RHWA_RELEASE/html/remediation_fencing_and_maintenance.html|;" "${CSV}"

# Update Channels for annotations.yaml file - EUS version
sed -r -i "s|channels.v1:.*|channels.v1: ${CHANNELS}|;" "${ANNOTATIONS}"

rm -rf "${UPSTREAM_DIR}"
